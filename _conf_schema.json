{
  "port": {
    "type": "int",
    "description": "监听端口",
    "default": 6198,
    "hint": "桌宠桥的监听端口，两边必须一致"
  },
  "auth_token": {
    "type": "string",
    "description": "校验 token",
    "default": "",
    "hint": "和桌宠扩展填同一串；留空不校验"
  },
  "usage_mode": {
    "type": "string",
    "description": "使用场景",
    "default": "qq",
    "options": [
      "qq",
      "local"
    ],
    "labels": [
      "接入 QQ",
      "纯桌宠"
    ],
    "hint": "纯桌宠只有本机；接入 QQ 才有平台账号"
  },
  "memory_share_mode": {
    "type": "string",
    "description": "记忆共享模式",
    "default": "shared",
    "options": [
      "shared",
      "pet_only"
    ],
    "labels": [
      "一起记",
      "桌宠单独记"
    ],
    "hint": "一起记＝两边共用；桌宠单独记＝只给桌宠用",
    "condition": {
      "usage_mode": "qq"
    }
  },
  "bot_qq": {
    "type": "string",
    "description": "桌宠的 QQ 号",
    "default": "",
    "hint": "机器人的 QQ 号",
    "condition": {
      "usage_mode": "qq"
    }
  },
  "bot_name": {
    "type": "string",
    "description": "桌宠的称呼",
    "default": "",
    "hint": "机器人的称呼",
    "condition": {
      "usage_mode": "qq"
    }
  },
  "bot_aliases_text": {
    "type": "list",
    "description": "桌宠的其他叫法",
    "default": [],
    "hint": "一行一个，想加几个加几个",
    "condition": {
      "usage_mode": "qq"
    }
  },
  "user_name": {
    "type": "string",
    "description": "你的称呼",
    "default": "",
    "hint": "桌宠这边怎么称呼你，纯桌宠也生效",
    "condition": {
      "usage_mode": "local"
    }
  },
  "user_map": {
    "type": "list",
    "description": "谁是谁",
    "default": [],
    "hint": "一行一个，QQ 号=名字,别名",
    "condition": {
      "usage_mode": "qq"
    }
  },
  "user_names_text": {
    "type": "string",
    "description": "用户本名映射",
    "default": "",
    "hint": "QQ 号对应的人名，换行或逗号分隔",
    "invisible": true
  },
  "user_aliases_text": {
    "type": "string",
    "description": "用户别名映射",
    "default": "",
    "hint": "同一个人的其他叫法",
    "invisible": true
  },
  "enable_auto_reflection": {
    "type": "bool",
    "description": "自动总结桌宠对话",
    "default": true,
    "hint": "桌宠对话自动整理成记忆"
  },
  "enable_auto_graph_metadata": {
    "type": "bool",
    "description": "自动建立记忆关联",
    "default": true,
    "hint": "自动补记忆之间的关联"
  },
  "default_persona_id": {
    "type": "string",
    "description": "记忆存给哪个人格",
    "default": "",
    "hint": "留空自动识别 一般不用填"
  },
  "pet_persona_id": {
    "type": "string",
    "description": "桌宠单独记的人格",
    "default": "",
    "hint": "留空自动用上面人格加「-桌宠」",
    "condition": {
      "usage_mode": "qq",
      "memory_share_mode": "pet_only"
    }
  },
  "default_session_id": {
    "type": "string",
    "description": "记忆存到哪个会话（高级）",
    "default": "",
    "hint": "接多平台或换过账号才要填，一般留空",
    "_special": "umo"
  },
  "default_adapter_id": {
    "type": "string",
    "description": "消息从哪个平台进来（高级）",
    "default": "",
    "hint": "高级项，多适配器互通时才要填，一般留空",
    "condition": {
      "usage_mode": "qq"
    }
  },
  "read_scope_sessions_text": {
    "type": "text",
    "description": "私聊额外读取的群会话",
    "default": "",
    "hint": "私聊检索时额外并入的群会话，一般留空",
    "invisible": true,
    "condition": {
      "usage_mode": "qq"
    }
  },
  "recall_keyword_boost": {
    "type": "bool",
    "description": "关键词子串增强",
    "default": true,
    "hint": "开启后，除向量/BM25 外额外走一条「关键词子串」检索：从查询里抽取英文标识、中文短词、数字 ID，直接在上游记忆正文里做子串匹配，再按 RRF 并入结果。专有名词、工具名、型号、文件名这类稀有词靠它才能稳定召回。关掉后行为与未加此功能时完全一致。"
  }
}
